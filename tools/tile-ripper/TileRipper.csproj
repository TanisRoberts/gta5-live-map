<!--
  Build with build.ps1, which fetches and builds CodeWalker.Core first and
  passes its path in. See the README in this folder for why CodeWalker is not
  vendored here.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>TileRipper</AssemblyName>
    <RootNamespace>GtaLiveMap.TileRipper</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <!-- Same versions CodeWalker.Core itself resolves, so we load one copy. -->
  <ItemGroup>
    <PackageReference Include="SharpDX" Version="4.2.0" />
    <PackageReference Include="SharpDX.Mathematics" Version="4.2.0" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="CodeWalker.Core">
      <HintPath>$(CodeWalkerCorePath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckCodeWalker" BeforeTargets="Build" Condition="!Exists('$(CodeWalkerCorePath)')">
    <Error Text="CodeWalker.Core.dll not found at '$(CodeWalkerCorePath)'. Run tools\tile-ripper\build.ps1, which builds it for you." />
  </Target>

  <!--
    CodeWalker.Core reads these at runtime from its own folder. Without
    ShadersGen9Conversion.xml every .ydd load throws, which silently costs us
    the whole vector map, so they must sit next to our exe too.
  -->
  <Target Name="CopyCodeWalkerData" AfterTargets="Build" Condition="Exists('$(CodeWalkerCorePath)')">
    <PropertyGroup>
      <_CwDir>$([System.IO.Path]::GetDirectoryName('$(CodeWalkerCorePath)'))</_CwDir>
    </PropertyGroup>
    <ItemGroup>
      <_CwData Include="$(_CwDir)\ShadersGen9Conversion.xml" Condition="Exists('$(_CwDir)\ShadersGen9Conversion.xml')" />
      <_CwData Include="$(_CwDir)\strings.txt" Condition="Exists('$(_CwDir)\strings.txt')" />
    </ItemGroup>
    <Copy SourceFiles="@(_CwData)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
